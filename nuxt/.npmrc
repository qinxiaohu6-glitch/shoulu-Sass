# npm tries to auto-install every optional peer of unstorage/nitro, which drags
# in dozens of cloud SDKs (Azure, AWS, GCP) and makes `npm install` take minutes.
# None of them are used here — the only storage backend is D1.
legacy-peer-deps=true
fund=false
audit=false

# Default registry: the China mirror. It served tarballs at ~3 MB/s here vs
# ~360 KB/s from registry.npmjs.org, and for every package we depend on it is
# in sync with upstream (verified: nuxt 4.6.4, @nuxt/ui 4.12.0, reka-ui 2.11.0,
# @nuxtjs/i18n 10.6.0, @nuxt/kit 4.6.4, @vueuse/core 15.0.0 ... all match).
registry=https://registry.npmmirror.com

# Exception: the whole @tanstack scope is stale on the mirror.
#   @tanstack/vue-virtual   mirror 3.13.52   official 3.19.11
#   @tanstack/virtual-core  mirror 3.19.10   official 3.19.11
# @nuxt/ui -> reka-ui pins @tanstack/vue-virtual, which in turn pins
# virtual-core to the exact same version, so a lagging mirror makes install
# die with ETARGET "No matching version found". Pull that scope from upstream.
@tanstack:registry=https://registry.npmjs.org/
